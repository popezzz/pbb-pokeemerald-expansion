mapscripts MitisTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
      setflag(FLAG_VISITED_LITTLEROOT_TOWN)
    }

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_LITTLEROOT_TOWN_STATE, 0: MitisTown_EventScript_JakeIntro
    ]

}

# -------- TRIGGERS AND STORY SCRIPTS --------------------

script MitisTown_Trigger_Parents1 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Mitis_WalkToParents_1)
    waitmovement(0)
    goto(MitisTown_EventScript_Parents)
}

script MitisTown_Trigger_Parents2 {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Mitis_WalkToParents_2)
    waitmovement(0)
    goto(MitisTown_EventScript_Parents)
}

script MitisTown_EventScript_Parents {
    msgbox(MitisTown_ParentsDialogue1)
    applymovement(MITIS_TOWN_ID_MOM, Mitis_ParentsSurprised)
    applymovement(MITIS_TOWN_ID_DAD, Mitis_ParentsSurprised)
    waitmovement(0)
  
    msgbox(MitisTown_ParentsDialogue2)
    closemessage
    applymovement(MITIS_TOWN_ID_MOM, Mitis_MomWalkAway)
    applymovement(MITIS_TOWN_ID_DAD, Mitis_DadWalkAway)
    waitmovement(0)
    removeobject(MITIS_TOWN_ID_MOM)
    removeobject(MITIS_TOWN_ID_DAD)

    
    msgbox("{SPEAKER NAME_PLAYER}... I should get going.")
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Mitis_WalkAway)
    waitmovement(0)

    setflag(FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE)
    setvar(VAR_LITTLEROOT_TOWN_STATE, 2)

    releaseall
}

script MitisTown_EventScript_JakeIntro {
    lockall
    msgbox("Hey {PLAYER}, it's me, Jake!")
    closemessage

    addobject(MITIS_TOWN_ID_JAKE_INTRO)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_BRENDAN)

    applymovement(OBJ_EVENT_ID_PLAYER, Mitis_FaceLeft)
    waitmovement(0)
    applymovement(MITIS_TOWN_ID_JAKE_INTRO, Jake_Intro_ToPlayer)
    waitmovement(0)
  
    setspeaker("Jake")
    msgbox(MitisTown_JakeDialogue)
    closemessage
    applymovement(MITIS_TOWN_ID_JAKE_INTRO, Jake_Intro_ToLab)
    waitmovement(0)
    
    removeobject(MITIS_TOWN_ID_JAKE_INTRO)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_BRENDAN)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE)
    setvar(VAR_LITTLEROOT_TOWN_STATE, 1)
  
    releaseall
}

script MitisTown_Trigger_BlockPath {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Mitis_FaceRight)
    waitmovement(0)
    releaseall
    goto(MitisTown_EventScript_Fisherman)
}

script MitisTown_Trigger_FishermanSpecial {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Mitis_SpecialTrigger_Fisherman)
    waitmovement(0)
    releaseall
    goto(MitisTown_EventScript_Fisherman)
}

# ------------------ SIGNS -------------------------

script MitisTown_EventScript_TownSign {
    lockall
    msgbox(MitisTownSign)
    releaseall
}

script MitisTown_EventScript_PlayersHouseSign {
    lockall
    msgbox("{PLAYER}'s House.")
    releaseall
}

script MitisTown_EventScript_RivalsHouseSign {
    lockall
    msgbox("Jake's House.")
    releaseall
}

script MitisTown_EventScript_LabSign {
    lockall
    msgbox("Roria Pokémon research lab.")
    releaseall
}

script MitisTown_EventScript_DiggingSiteSign {
    lockall
    msgbox("Mitis Town Digging Site.\pNote: those ledges are supposed\nto be stairs...")
    releaseall
}

# ------------------ NPCs --------------------

script MitisTown_EventScript_Scientist {
    lockall
    faceplayer
    msgbox(MitisTown_ScientistDialogue, MSGBOX_AUTOCLOSE)
    applymovement(MITIS_TOWN_ID_SCIENTIST, moves(face_right))
    waitmovement(0)
    releaseall
}

script MitisTown_EventScript_TechBoy {
    lockall
    faceplayer
    msgbox(MitisTown_TechBoyDialogue, MSGBOX_AUTOCLOSE)
    releaseall
}

script MitisTown_EventScript_Camper {
    lockall
    faceplayer
    msgbox(MitisTown_CamperDialogue, MSGBOX_AUTOCLOSE)
    releaseall
}

script MitisTown_EventScript_Woman {
    lockall
    faceplayer
    msgbox(MitisTown_PokeballDialogue, MSGBOX_AUTOCLOSE)
    releaseall
}

script MitisTown_EventScript_Fisherman {
    lockall
    faceplayer
    switch(var(VAR_LITTLEROOT_INTRO_STATE)) {
      case 0:
        msgbox("You don't have a Pokémon yet, right?\nYou should go to the lab first.", MSGBOX_AUTOCLOSE)
        applymovement(OBJ_EVENT_ID_PLAYER, Mitis_WalkUp)
      case 1:
        msgbox("Good luck on your Journey!\pIf you need help, talk to me.\nI'll heal your Pokémon!", MSGBOX_AUTOCLOSE)
        applymovement(OBJ_EVENT_ID_PLAYER, Mitis_WalkAway)
        setvar(VAR_LITTLEROOT_INTRO_STATE, 2)
      default:
        msgbox("Here, let me heal your Pokémon!")
        //heal mons here.
    }
    applymovement(MITIS_TOWN_ID_FISHERMAN, moves(face_left))
    waitmovement(0)
    releaseall
}

# --------------- TEXTBOXES -----------------------

text MitisTownSign {
    "Mitis Town.\n"
    "The fresh breeze of a new start."
}

text MitisTown_JakeDialogue {
    "I can't believe the day has come!\nWe'll finally get our first Pokémon!\p"
    "I saw your parents go to the digging site.\nYou should go check them.\lI'll wait for you at the lab!"
}

text MitisTown_ParentsDialogue1 {
    "{SPEAKER NAME_MOM}Well that ought to take care of it...\p"
    "{SPEAKER NAME_DAD}We have to keep this a secret, for\neveryone's safety.\p"
    "{SPEAKER NAME_MOM}You're right.\pIt's too dangerous for anyone to go\ndown there.\p"
    "{SPEAKER NAME_DAD}I don't think we should tell anybody\nabout this.\p"
    "{SPEAKER NAME_MOM}Maybe we can tell that new professor.\p"
    "{SPEAKER NAME_DAD}Maybe you're right."
}

text MitisTown_ParentsDialogue2 {
    "{SPEAKER NAME_MOM}{PLAYER}! You startled us!\p"
    "{SPEAKER NAME_DAD}Hey champ!\pToday is the day you get your first\nPokémon!\p"
    "{SPEAKER NAME_MOM}We are so happy for you, sweetie!\p"
    "{SPEAKER NAME_DAD}Sorry we didn't meet you at home.\pWe just discovered something in the\ncave last night.\p"
    "{SPEAKER NAME_DAD}As archeologists, your mother and I are\nvery thorough in our work.\p"
    "{SPEAKER NAME_MOM}That's right, but enough talking.\pLet's head down to the research lab\nand let you pick your very first\lPokémon!\p"
    "{SPEAKER NAME_DAD}We'll see you there!"
}

text MitisTown_ScientistDialogue {
    "At the end of the road lies Roria's\nPokémon research lab.\p"
    "Years of studies on Pokémon are\nstored and mantained there."
}

text MitisTown_TechBoyDialogue {
    "Technology is amazing!\p"
    "People can easily make their own\ngames using decomps!"
}

text MitisTown_CamperDialogue {
    "I'm not a good swimmer.\n"
    "Matter of fact, I'm scared of water.\p"
    "People sometimes use Pokémon to\ntravel on water.\p"
    "I wonder if that'll help me\nfight my fear of water..."
}

text MitisTown_PokeballDialogue {
    "Some Pokéballs are better\nthan others.\p"
    "Some work better on certain Pokémon\nwhile others work better in\lspecific places."
}

# ------------ MOVEMENT ----------------------

movement Mitis_FaceRight {
    face_right
}

movement Mitis_FaceLeft {
    face_left
}

movement Mitis_WalkUp {
    walk_up
}

movement Jake_Intro_ToPlayer {
    walk_down * 6
    face_right
    walk_right * 4
}

movement Jake_Intro_ToLab {
    face_left
    walk_left * 4
    face_up
    walk_up * 6
}

movement Mitis_WalkToParents_1 {
    walk_up * 4
    face_left
    walk_left * 2
    face_up
}

movement Mitis_WalkToParents_2 {
    walk_up * 4
    face_left
    walk_left * 3
    face_up
}

movement Mitis_ParentsSurprised {
    face_down
    emote_exclamation_mark
    delay_16
    delay_16
}

movement Mitis_MomWalkAway {
    face_right
    walk_right * 2
    face_down
    walk_down * 6
}

movement Mitis_DadWalkAway {
    face_right
    walk_right * 3
    face_down
    walk_down * 6
}

movement Mitis_WalkAway {
    face_down
    walk_down
}

movement Mitis_SpecialTrigger_Fisherman {
    face_left
    walk_left
    face_down
    walk_down
    face_right
}

