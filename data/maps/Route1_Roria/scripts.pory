mapscripts Route1_Roria_MapScripts {
}

script Route1_Trainer_Ralph {
    trainerbattle_single(TRAINER_ROUTE_1_RALPH, Route1_Text_RalphIntro, Route1_Text_RalphDefeat)
    goto_if_defeated(TRAINER_ROUTE_1_RALPH, Route1_EventScript_RalphPostBattle)
    end
}

script Route1_EventScript_RalphPostBattle {
    lockall
    msgbox("You're pretty strong!\nWant a rematch?", MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, YES, Route1_EventScript_RalphRematch)
    release
}

script Route1_EventScript_RalphRematch {
    trainerbattle_no_intro(TRAINER_ROUTE_1_RALPH, Route1_Text_RalphDefeat)
    release
}

text Route1_Text_RalphIntro {
  "I'll battle you with the bug type\n"
  "Pokémon I just caught."
}

text Route1_Text_RalphDefeat {
  "Maybe bug type Pokémon are not the\n"
  "strongest..."
}

