        release
        goto(MitisTown_Lab_ObtainPokedex)
      }
    case 2:
    default:
      msgbox("I shouldn't take another, for now.", MSGBOX_AUTOCLOSE)
  }
  release
}

script StarterFade {
  fadescreen(FADE_TO_BLACK)
  delay(20)
  fadescreen(FADE_FROM_BLACK)
  return
}

script NicknamePartyMon{
    msgbox("Give it a nickname?", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
}

script GrassStarterChoice {
  switch(var(VAR_STARTER_REGION)) {
    case 1:
      showmonpic(SPECIES_CHIKORITA, 10, 3)
			setspeaker("Prof. Cypress")
			msgbox("So, will you choose Chikorita, the\nGrass type Pokémon?", MSGBOX_YESNO)
      if(var(VAR_RESULT) == YES) {
        givemon(SPECIES_CHIKORITA, 5)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
          setspeaker(NULL)
					playfanfare(MUS_OBTAIN_ITEM)
          msgbox("Received Chikorita!")
          waitfanfare
          removeobject(7)
          call(NicknamePartyMon)
          if(var(VAR_BIRCH_LAB_STATE) == 1) {
            setflag(FLAG_SYS_POKEMON_GET)
          }
        }
        else {
          hidemonpic
          msgbox("No more room in party.", MSGBOX_AUTOCLOSE)  
        }
        setvar(VAR_BIRCH_LAB_STATE, 2)
      }
      else {
        hidemonpic
        msgbox("Take your time.", MSGBOX_AUTOCLOSE)  
      }
    case 2:
      showmonpic(SPECIES_TREECKO, 10, 3)
