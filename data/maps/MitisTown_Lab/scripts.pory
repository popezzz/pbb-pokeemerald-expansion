mapscripts MitisTown_Lab_MapScripts {
  MAP_SCRIPT_ON_TRANSITION {
    if (var(VAR_LITTLEROOT_TOWN_STATE) == 1) {
      setvar(VAR_BIRCH_LAB_STATE, 0)
      setflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_HOUSE_VIGOROTH_2) // hide second professor
      setflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_BEDROOM_MOM) // hide parents
      setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_MOM) // hide Cypress
    }
    elif (var(VAR_LITTLEROOT_TOWN_STATE) == 2) {
      clearflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_MOM)
      clearflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_BEDROOM_MOM)
    }
  }
}

# ---------- NPC Scripts -------------

script MitisTown_Lab_EventScript_Scientist {
  lockall
  faceplayer
  msgbox(MitisTown_Lab_MegaEvoDialogue, MSGBOX_AUTOCLOSE)
  applymovement(1, moves(face_up))
  waitmovement(0)
  releaseall
}

script MitisTown_Lab_EventScript_AssistantDave {
  lockall
  faceplayer
  switch(var(VAR_BIRCH_LAB_STATE)) {
    case 0:
      msgbox(MitisTown_Lab_DaveInfo, MSGBOX_AUTOCLOSE)
      msgbox(MitisTown_Lab_DaveChooseForFree, MSGBOX_AUTOCLOSE)
    case 1:
      msgbox(MitisTown_Lab_DaveChangeStarters, MSGBOX_AUTOCLOSE)
    default:
      msgbox(MitisTown_Lab_DaveInfo, MSGBOX_AUTOCLOSE)
      
  }
  applymovement(MITIS_LAB_ID_ASSISTANT_DAVE, moves(face_down))
  waitmovement(0)
  releaseall
}

script MitisTown_Lab_EventScript_Jake {
  lockall
  faceplayer
  msgbox(MitisTown_Lab_JakeIntro, MSGBOX_AUTOCLOSE)
  applymovement(MITIS_LAB_ID_JAKE, moves(face_left))
  waitmovement(0)
  releaseall
}

# ----------- TEXTBOXES ----------------

text MitisTown_Lab_MegaEvoDialogue {
  "I'm researching Mega Evolution.\p"
  "Such a wonderful and mysterious phenomena...\p"
  "I've had the opportunity to\ntalk with Professor Sycamore from\lthe Kalos region about it."
}

text MitisTown_Lab_DaveInfo {
  "The professor gives trainers a\nrare Pokémon every 20 species they\lregister on the Pokédex."
}

text MitisTown_Lab_DaveChangeStarters {
  "lorem ipsum"
}

text MitisTown_Lab_JakeIntro {
  "Professor Cypress should be here\nany minute now, so go check your\lparents."
  "Your parents are at the digging\nsite."
}

text MitisTown_Lab_DaveChooseForFree {
  "For this occasion though, you'll\nget one for free!"
}
