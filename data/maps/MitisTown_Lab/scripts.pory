# ---------- NPC Scripts -------------

script MitisTown_Lab_EventScript_Scientist {
  lockall
  faceplayer
  msgbox(MitisTown_Lab_MegaEvoDialogue, MSGBOX_AUTOCLOSE)
  applymovement(1, moves(face_up))
  waitmovement(0)
  releaseall
}

script MitisTown_Lab_EventScript_AssistantDave {
  lock
  faceplayer
  switch(var(VAR_BIRCH_LAB_STATE)) {
    case 0:
      setspeaker("Dave")
      msgbox(MitisTown_Lab_DaveInfo, MSGBOX_NPC)
      setspeaker("Dave")
      msgbox(MitisTown_Lab_DaveChooseForFree, MSGBOX_NPC)
    case 1:
      setspeaker("Dave")
      msgbox(MitisTown_Lab_DaveChangeStarters)
      dynmultichoice(25, 5, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE,
        "Kanto",
        "Johto",
        "Hoenn",
        "Sinnoh",
        "Unova",
        "Kalos",
        "Alola",
        "Galar",
        "Paldea"
      ) 
      closemessage
      switch(var(VAR_RESULT)) {
        case 1:
          call(StarterFade)
          setvar(VAR_STARTER_REGION, 1)
        case 2:
          call(StarterFade)
          setvar(VAR_STARTER_REGION, 2)
        case 3:
          call(StarterFade)
          setvar(VAR_STARTER_REGION, 3)
        case 4:
          call(StarterFade)
          setvar(VAR_STARTER_REGION, 4)
        case 5:
          call(StarterFade)
          setvar(VAR_STARTER_REGION, 5)
        case 6:
          call(StarterFade)
          setvar(VAR_STARTER_REGION, 6)
        case 7:
          call(StarterFade)
          setvar(VAR_STARTER_REGION, 7)
        case 8:
          call(StarterFade)
          setvar(VAR_STARTER_REGION, 8)
        case 0:
        default:
          call(StarterFade)
          setvar(VAR_STARTER_REGION, 0)
      }
      setspeaker("Dave")
      msgbox("Choose Wisely.", MSGBOX_NPC)
      waitmessage
    default:
      setspeaker("Dave")
      msgbox(MitisTown_Lab_DaveInfo, MSGBOX_AUTOCLOSE)
      
  }
  applymovement(MITIS_LAB_ID_ASSISTANT_DAVE, moves(face_down))
  waitmovement(0)
  release
}

script MitisTown_Lab_EventScript_Jake {
  lockall
  faceplayer
  setspeaker("Jake")
  msgbox(MitisTown_Lab_JakeIntro, MSGBOX_NPC)
  applymovement(MITIS_LAB_ID_JAKE, moves(face_left))
  waitmovement(0)
  releaseall
}

# ----------- TEXTBOXES ----------------

text MitisTown_Lab_MegaEvoDialogue {
  "I'm researching Mega Evolution.\p"
  "Such a wonderful and mysterious phenomena...\p"
  "I've had the opportunity to\ntalk with Professor Sycamore from\lthe Kalos region about it."
}

text MitisTown_Lab_DaveInfo {
  "The professor gives trainers a\nrare Pokémon every 20 species they\lregister on the Pokédex."
}

text MitisTown_Lab_DaveChangeStarters {
  "What region would you like to choose?"
}

text MitisTown_Lab_JakeIntro {
  "Professor Cypress should be here\nany minute now, so go check your\lparents.\p"
  "Your parents are at the digging\nsite."
}

text MitisTown_Lab_DaveChooseForFree {
  "For this occasion though, you'll\nget one for free!"
}

text MitisTown_Lab_CypressIntro {
  "Hello, My name is Professor Cypress.\n"
  "I am the new professor in Mitis Town.\p"
  "I'll bet you're {PLAYER}. Your parents\n"
  "were just telling me about you.\p"
  "You must be very excited to get your\n"
  "first Pokémon today.\p"
  "There are a few things you must know\n"
  "about Pokémon first.\p"
  "Pokémon are our friends, and we grow\n"
  "alongside them. They grow, and in\l"
  "some cases evolve and change form, as\l"
  "we battle with them.\p"
  "Your Pokémon will grow to love you as\n"
  "you adventure with them.\p"
  "There are still lots of things we do not\n"
  "fully know about Pokémon.\p"
  "{PLAYER}, I want you now to pick a\n"
  "Pokémon that will accompany you on your\l"
  "adventures.\p"
  "Make a choice between one of these 27\n"
  "different species. Talk to my assistant\l"
  "Dave if you want to see species from\l"
  "other regions.\p"
  "Go ahead now."
}

text MitisTown_Lab_CypressGivePokedex {
  "{SPEAKER NAME_CYPRESS}Excellent choice, {PLAYER}!\p"
  "{SPEAKER NAME_MOM}Your new Pokémon is so cute!\p"
  "{SPEAKER NAME_DAD}That definitely has battle potential!\p"
  "{SPEAKER NAME_JAKE}I hope you and your Pokémon become best\nfriends like we are!\p"
  "{SPEAKER NAME_CYPRESS}Alright, {PLAYER}, many challenges await\nyou.\pLet me give you one more gift that will\nhelp you along your way\p"
  "{SPEAKER NAME_CYPRESS}It's a Pokédex.\pIt's an electronic encyclopedia that\nrecords the kinds of Pokémon you\lencounter and capture.\p"
  "{SPEAKER NAME_CYPRESS}Not only that, you'll also help the lab's\nresearch efforts!"
}

text MitisTown_Lab_PokedexObtained {
  "{SPEAKER NAME_CYPRESS}Also, once every 20 species of Pokémon\nyou register on the Pokédex, you can\lcome back here and get another one of \lthese rare Pokémon for free!\l"
  "{SPEAKER NAME_CYPRESS}Be sure to check it out!\p"
  "{SPEAKER NAME_CYPRESS}Now, what are you waiting for?\pGo and explore the world of Pokémon!\p"
  "{SPEAKER NAME_DAD}That's right, {PLAYER}. Go ahead and have\nfun with your new Pokémon.\pWe need to stay behind and talk to the\nprofessor for a minute.\pWe'll meet up with you later."
}

text MitisTown_Lab_CypressGoodLuck {
  "{SPEAKER NAME_CYPRESS}I wish you best of luck on your journey,\n{PLAYER}!"
}

text MitisTown_Lab_JakeBattleIntro {
  "{SPEAKER NAME_JAKE}We have Pokémon now!\pLET'S BATTLE!!"    
}

text MitisTown_Lab_JakeBattleOutro {
  "Amazing!"
}

text MitisTown_Lab_JakePostBattle {
  "Nice fighting!\pHere, let me heal your Pokémon."
}

# --------------- MOVEMENT -------------------

movement MitisLab_WalkToCypress {
  face_up
  walk_up * 8
}

movement MitisLab_WalkToTable {
  face_down
  walk_down
  face_right
  walk_right * 3
  face_up
}

movement MitisLab_GrassToCypress {
  face_left
  walk_left * 2
  face_up
  walk_up
}

movement MitisLab_FireToCypress {
  face_left
  walk_left * 3
  face_up
  walk_up
}

movement MitisLab_WaterToCypress {
  face_left
  walk_left * 4
  face_up
  walk_up
}

