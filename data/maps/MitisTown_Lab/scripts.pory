mapscripts MitisTown_Lab_MapScripts {
  MAP_SCRIPT_ON_TRANSITION {
    if (var(VAR_LITTLEROOT_TOWN_STATE) == 1) {
      setvar(VAR_BIRCH_LAB_STATE, 0)
      setflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_HOUSE_VIGOROTH_2) // hide second professor
      setflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_BEDROOM_MOM) // hide parents
      setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_MOM) // hide Cypress
    }
    elif (var(VAR_LITTLEROOT_TOWN_STATE) == 2) {
      clearflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_MOM)
      clearflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_BEDROOM_MOM)
      setflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_HOUSE_VIGOROTH_2)
    }
  }
  MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
    VAR_LITTLEROOT_TOWN_STATE, 2 {
      turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
    }
  ]

  MAP_SCRIPT_ON_FRAME_TABLE [
    VAR_LITTLEROOT_TOWN_STATE, 2: MitisTown_Lab_StarterChoiceIntro
  ]
}

# ------------ Main Story Scripts and Triggers --------------------

script MitisTown_Lab_StarterChoiceIntro {
  lockall
  applymovement(OBJ_EVENT_ID_PLAYER, MitisLab_WalkToCypress)
  waitmovement(0)
  setspeaker("Prof. Cypress")
  msgbox(MitisTown_Lab_CypressIntro, MSGBOX_AUTOCLOSE)
  waitmessage
  applymovement(OBJ_EVENT_ID_PLAYER, MitisLab_WalkToTable)
  waitmovement(0)
  setvar(VAR_BIRCH_LAB_STATE, 1)
  setvar(VAR_LITTLEROOT_TOWN_STATE, 3)
  releaseall
}

script MitisTown_Lab_ObtainPokedex {
  lockall
  msgbox(MitisTown_Lab_CypressGivePokedex, MSGBOX_NPC)
  playfanfare(MUS_RG_OBTAIN_KEY_ITEM)
  msgbox("Obtained the Pokédex!")
  waitfanfare
  setflag(FLAG_SYS_POKEDEX_GET)
  special(SetUnlockedPokedexFlags)
  setflag(FLAG_SYS_NATIONAL_DEX)
  special(EnableNationalPokedex)
  msgbox(MitisTown_Lab_PokedexObtained, MSGBOX_NPC)
  msgbox(MitisTown_Lab_CypressGoodLuck)
  releaseall
  goto(MitisTown_Lab_RivalBattle)
}

script MitisTown_Lab_RivalBattle {
  lock
  applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down, walk_down * 6))
  waitmovement(0)

  playse(SE_PIN)
  applymovement(MITIS_LAB_ID_JAKE, moves(emote_exclamation_mark, delay_16 * 2))
  waitmovement(0)
  msgbox("{SPEAKER NAME_JAKE}Hey, {PLAYER}, wait up!", MSGBOX_NPC)
  closemessage

  playbgm(MUS_ENCOUNTER_BRENDAN, 0)
  applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
  applymovement(MITIS_LAB_ID_JAKE, moves(walk_fast_left * 3, face_down, walk_fast_down * 2))
  waitmovement(0)

  setflag(FLAG_NO_WHITEOUT)
  msgbox(MitisTown_Lab_JakeBattleIntro, MSGBOX_NPC)
  trainerbattle_no_intro(TRAINER_JAKE_MITIS_LAB, MitisTown_Lab_JakeBattleOutro)
  clearflag(FLAG_NO_WHITEOUT)
  fadedefaultbgm
  msgbox(MitisTown_Lab_JakePostBattle)
  special(HealPlayerParty)
  release
}

script MitisTown_Lab_Trigger_ChooseStarter_1 {
  lockall
  msgbox("Don't leave without choosing your\nPokémon!", MSGBOX_AUTOCLOSE)
  applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up, walk_up))
  waitmovement(0)
  releaseall
}

script MitisTown_Lab_Trigger_ChooseStarter_2 {
  lockall
  msgbox("Don't leave without choosing your\nPokémon!", MSGBOX_AUTOCLOSE)
  applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left, walk_left))
  waitmovement(0)
  releaseall
}

script MitisTown_Lab_Trigger_ChooseStarter_3 {
  lockall
  msgbox("Don't leave without choosing your\nPokémon!", MSGBOX_AUTOCLOSE)
  applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right, walk_right))
  waitmovement(0)
  releaseall
}

script MitisTown_Lab_EventScript_GrassBall {
  lock
  switch(var(VAR_BIRCH_LAB_STATE)) {
    case 0:
      msgbox("I should wait...", MSGBOX_AUTOCLOSE)
    case 1:
      call(GrassStarterChoice)
      if(flag(FLAG_SYS_POKEMON_GET))
        applymovement(OBJ_EVENT_ID_PLAYER, MitisLab_GrassToCypress)
        waitmovement(0)
        release
        goto(MitisTown_Lab_ObtainPokedex)
      }
    case 2:
    default:
      msgbox("I shouldn't take another, for now.", MSGBOX_AUTOCLOSE)
  }
  release
}

script MitisTown_Lab_EventScript_FireBall {
  lock
  switch(var(VAR_BIRCH_LAB_STATE)) {
    case 0:
      msgbox("I should wait...", MSGBOX_AUTOCLOSE)
    case 1:
      call(FireStarterChoice)
        if(flag(FLAG_SYS_POKEMON_GET)) {
        applymovement(OBJ_EVENT_ID_PLAYER, MitisLab_FireToCypress)
        waitmovement(0)
        release
        goto(MitisTown_Lab_ObtainPokedex)
      }
    case 2:
    default:
      msgbox("I shouldn't take another, for now.", MSGBOX_AUTOCLOSE)
  }
  release
}

script MitisTown_Lab_EventScript_WaterBall {
  lock
  switch(var(VAR_BIRCH_LAB_STATE)) {
    case 0:
      msgbox("I should wait...", MSGBOX_AUTOCLOSE)
    case 1:
