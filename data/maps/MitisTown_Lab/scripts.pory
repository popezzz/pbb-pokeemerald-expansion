  }
  return
}

script WaterStarterChoice {
  switch(var(VAR_STARTER_REGION)) {
    case 1:
      showmonpic(SPECIES_TOTODILE, 10, 3)
			setspeaker("Prof. Cypress")
			msgbox("So, will you choose Totodile, the\nWater type Pokémon?", MSGBOX_YESNO)
      if(var(VAR_RESULT) == YES) {
        givemon(SPECIES_TOTODILE, 5)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
          setspeaker(NULL)
					playfanfare(MUS_OBTAIN_ITEM)
          msgbox("Received Totodile!")
          waitfanfare
          removeobject(9)
          call(NicknamePartyMon)
          if(var(VAR_BIRCH_LAB_STATE) == 1) {
            setflag(FLAG_SYS_POKEMON_GET)
          }
        }
        else {
          hidemonpic
          msgbox("No more room in party.", MSGBOX_AUTOCLOSE)  
        }
        setvar(VAR_BIRCH_LAB_STATE, 2)
      }
      else {
        hidemonpic
        msgbox("Take your time.", MSGBOX_AUTOCLOSE)  
      }
