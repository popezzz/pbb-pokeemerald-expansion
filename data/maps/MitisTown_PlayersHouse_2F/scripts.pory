mapscripts MitisTown_PlayersHouse_2F_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_LITTLEROOT_HOUSES_STATE_BRENDAN, 0 {
            turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
        }
    ]

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_LITTLEROOT_HOUSES_STATE_BRENDAN, 0: MitisTown_PlayersHouse_2F_IntroScript
    ]
}

script MitisTown_PlayersHouse_2F_IntroScript {
    lockall
    msgbox(PlayersHouse_EnoughGames)
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, PlayersHouse_JumpDown)
    waitmovement(0)
    msgbox(PlayersHouse_NewAdventure)
    
    applymovement(OBJ_EVENT_ID_PLAYER, PlayersHouse_FaceRight)
    waitmovement(0)
    msgbox(PlayersHouse_FillTrainerCard)
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, PlayersHouse_HeadToTable)
    waitmovement(0)
    fadescreen(FADE_TO_BLACK)
    special(NamePlayer)
    waitstate
    delay(30)
    
    msgbox(PlayersHouse_SetClock)
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, PlayersHouse_HeadToClock)
    waitmovement(0)
    call(MitisTown_PlayersHouse_2F_EventScript_SetWallClock)
    delay(30)
    setflag(FLAG_SET_WALL_CLOCK)

    msgbox(PlayersHouse_GoodToGo)
    setvar(VAR_LITTLEROOT_HOUSES_STATE_BRENDAN, 1)
    releaseall
}

movement PlayersHouse_FaceRight {
    face_right
}

movement PlayersHouse_HeadToTable {
    walk_right * 3
    face_up
    walk_up
}

movement PlayersHouse_HeadToClock {
    face_left
    walk_left * 4
    face_up
}

movement PlayersHouse_JumpDown {
  face_down
  jump_down
}

text PlayersHouse_EnoughGames {
  "... Ugh! Enough video games for today.\p"
  "After all..."
}

text PlayersHouse_NewAdventure {
    "...I'll finally get my first Pokémon\n"
    "Today!\p"
    "I can't wait to start my own adventure!"
}

text PlayersHouse_FillTrainerCard {
    "I just need to fill my trainer card..."
}

text PlayersHouse_SetClock {
    "...I also need to set the clock..."
}

text PlayersHouse_GoodToGo {
    "...Perfect! I'm good to go."
}

script MitisTown_PlayersHouse_2F_EventScript_SetWallClock {
    fadescreen(FADE_TO_BLACK)
    special(StartWallClock)
    return
}

script MitisTown_PlayersHouse_2F_EventScript_UseWallClock {
    fadescreen(FADE_TO_BLACK)
    special(Special_ViewWallClock)
    releaseall
}
