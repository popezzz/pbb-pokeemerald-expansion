mapscripts MitisTown_PlayersHouse_2F_MapScripts {
    
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_LITTLEROOT_HOUSES_STATE_BRENDAN, 0: MitisTown_PlayersHouse_2F_IntroScript
    ]
}

script MitisTown_PlayersHouse_2F_IntroScript {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, FaceUp)
    waitmovement(0)
    msgbox(EnoughGames)
    applymovement(OBJ_EVENT_ID_PLAYER, JumpDown)
    waitmovement(0)
    msgbox(NewAdventure)
    setvar(VAR_LITTLEROOT_HOUSES_STATE_BRENDAN, 1)
    releaseall
}

movement FaceUp {
    face_up
}

movement JumpDown {
  face_down
  jump_down
}

text EnoughGames {
  "... Ugh! Enough Games for today.\n"
  "After all..."
}

text NewAdventure {
    "...I'll finally get my first Pokémon\n"
    "Today!\l"
    "I can't wait to start my own adventure!"
}
